{
  "openapi":"3.0.3",
  "info":{"title":"Orders API demo","version":"1.0.0"},
  "paths":{
    "/orders":{
      "get":{"summary":"List orders","operationId":"listOrders","responses":{"200":{"description":"Order list"}}},
      "post":{"summary":"Create an order","operationId":"createOrder","requestBody":{"required":true},"responses":{"201":{"description":"Created"}}}
    },
    "/orders/{orderId}":{"get":{"operationId":"getOrder","parameters":[{"name":"orderId","in":"path","required":true}],"responses":{"200":{"description":"Order"}}}}
  }
}
